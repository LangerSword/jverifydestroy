<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jvd</groupId>
    <artifactId>jverifydestroy</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>web</artifactId>
  <name>jvd-web</name>
  <dependencies>
      <dependency>
        <groupId>io.jvd</groupId>
        <artifactId>evidence</artifactId>
      </dependency>
      <dependency>
        <groupId>io.jvd</groupId>
        <artifactId>log</artifactId>
      </dependency>
  </dependencies>
  <build>
    <plugins>
      <!--
        Produces one self-contained runnable jar: `java -jar web-1.0.0.jar 8080`.

        A deployment of this service wants a single file to copy: a container image
        layer, a jar dropped next to a systemd unit, or an artifact a hosting
        platform pulls. Without this, the operator has to assemble a classpath from
        the working tree, which is exactly what a deployment should not have to do.

        The service makes no network calls of its own and needs nothing at runtime
        beyond the JDK, so shading the two project modules it depends on is all
        that is needed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.jvd.web.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
